#!/bin/sh
# tarn's .deb holds no secrets and no config. A fresh install starts tarn in
# setup mode, which asks for the zone and token on a page on the tailnet.
set -e

if [ "$1" = configure ]; then
	systemd-sysusers tarn.conf
	if [ -d /run/systemd/system ]; then
		systemctl daemon-reload
		if [ -z "$2" ]; then
			systemctl enable --now tarn.service || true
		else
			# Upgrades restart a running tarn onto the new binary.
			systemctl try-restart tarn.service || true
		fi
	fi
	if [ -z "$2" ]; then
		echo "tarn is running in setup mode. To see the setup address and code: sudo tarn status"
		if [ -e /etc/systemd/system/tarn.service ]; then
			echo "Note: /etc/systemd/system/tarn.service exists and is used instead of the packaged unit."
		fi
	fi
fi
